# Database: SQLite by default for instant local testing.
# For production PostgreSQL, set: postgresql://user:password@localhost:5432/informeddiet
DATABASE_URL=sqlite:///./informeddiet.db

# Security & Auth
SECRET_KEY=change-this-secret-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
FIREBASE_CREDENTIALS_PATH=

# Vision Model Configuration (Qwen3-VL-8B-Instruct)
# Options:
#   demo_fallback  -> Works on Windows CPU immediately using master_nutrition.csv
#   remote_http    -> Connects to your Google Colab T4 GPU or remote GPU server (set VLM_REMOTE_URL)
#   local_unsloth  -> Runs unsloth/Qwen3-VL-8B-Instruct-unsloth-bnb-4bit directly on a Linux CUDA GPU
VLM_MODE=demo_fallback
VLM_MODEL_NAME=unsloth/Qwen3-VL-8B-Instruct-unsloth-bnb-4bit
VLM_REMOTE_URL=
MASTER_NUTRITION_CSV=./data/master_nutrition.csv
MAX_UPLOAD_MB=5

# Storage
UPLOAD_DIR=./uploads
